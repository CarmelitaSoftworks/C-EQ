<?xml version="1.0" encoding="utf-8"?>
<!--
  Ventana plegada de Winamp (275×14) con zonas táctiles encima, con pesos en píxeles del skin: la
  pantalla (0–169), los mini botones (anterior 7, reproducir 10, pausa 9, detener 9, siguiente 10,
  separación 1, expulsar 9) y el resto (51). Las posiciones son las de WinampWindow.shadeHit.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/shade_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout android:id="@+id/shade_display" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="169" android:contentDescription="@string/player_toggle" />
        <FrameLayout android:id="@+id/shade_previous" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7" android:contentDescription="@string/player_previous" />
        <FrameLayout android:id="@+id/shade_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="10" android:contentDescription="@string/player_play" />
        <FrameLayout android:id="@+id/shade_pause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="9" android:contentDescription="@string/player_pause" />
        <FrameLayout android:id="@+id/shade_stop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="9" android:contentDescription="@string/player_stop" />
        <FrameLayout android:id="@+id/shade_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="10" android:contentDescription="@string/player_next" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <FrameLayout android:id="@+id/shade_eject" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="9" android:contentDescription="@string/player_open" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="51" />
    </LinearLayout>
</FrameLayout>
